CsvFilePath: Wind/EOG_ASCII_25.wnd 		# Filename/path of the comma separated file (.csv, .wnd, etc.)
SwapIndex: 174                          # Index in swap array to write the signal to
InterpolateBetweenValues: true 			# true=linear interpolation, false=sample-and-hold
PreviewTime: 1.7 				    	# preview time
TimeColumnIndex: 1						# column number containing the time step (one-based column index)
ValueColumnIndex: 2						# column number containing the corresponding value (one-based column index)